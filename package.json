{
  "name": "boron-context",
  "version": "0.3.0",
  "description": "Open-source intention and context layer for agentic work",
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "boron-context": "./dist/cli.js"
  },
  "files": [
    "dist",
    "migrations",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test && npm run build",
    "dev": "tsx src/cli.ts serve",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node dist/cli.js serve",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/cli.ts migrate",
    "service:print": "tsx src/cli.ts print-launchd",
    "service:install": "tsx src/cli.ts install-launchd"
  },
  "keywords": [
    "agents",
    "context",
    "intention",
    "ontology",
    "mcp",
    "postgresql"
  ],
  "author": "Boron Context contributors",
  "license": "MIT",
  "homepage": "https://github.com/kforris/boron-context",
  "repository": {
    "type": "git",
    "url": "https://github.com/kforris/boron-context.git"
  },
  "bugs": {
    "url": "https://github.com/kforris/boron-context/issues"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "pg": "^8.22.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "@types/pg": "^8.20.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  }
}
